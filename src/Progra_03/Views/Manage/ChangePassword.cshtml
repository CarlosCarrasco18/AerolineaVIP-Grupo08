@model Progra_03.Models.ChangePasswordViewModel
@{
    ViewBag.Title = "Cambiar contraseña";
}

<div class="bg-brand-dark text-white py-5 mb-4">
    <div class="container py-3 text-center">
        <span class="badge text-gold mb-2 px-3 py-2 rounded-pill bg-white bg-opacity-10">
            Seguridad de la cuenta
        </span>
        <h1 class="fw-bold mb-1">Cambiar contraseña</h1>
        <p class="small mb-0 text-brand-muted">Mínimo 8 caracteres con mayúscula, minúscula, número y símbolo.</p>
    </div>
</div>

<div class="container mb-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
                @using (Html.BeginForm("ChangePassword", "Manage", FormMethod.Post, new { role = "form" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary("", new { @class = "text-danger small mb-3" })
                    <div class="mb-3">
                        @Html.LabelFor(m => m.OldPassword, new { @class = "form-label fw-bold text-muted small mb-1" })
                        @Html.PasswordFor(m => m.OldPassword, new { @class = "form-control rounded-3", autocomplete = "current-password" })
                    </div>
                    <div class="mb-3">
                        @Html.LabelFor(m => m.NewPassword, new { @class = "form-label fw-bold text-muted small mb-1" })
                        @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control rounded-3", autocomplete = "new-password" })
                    </div>
                    <div class="mb-4">
                        @Html.LabelFor(m => m.ConfirmPassword, new { @class = "form-label fw-bold text-muted small mb-1" })
                        @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control rounded-3", autocomplete = "new-password" })
                    </div>
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-gold rounded-pill py-2">Cambiar contraseña</button>
                        <a href="@Url.Action("Index")" class="btn btn-outline-secondary rounded-pill">Volver al perfil</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Html.Partial("_ScriptsValidacion")
}