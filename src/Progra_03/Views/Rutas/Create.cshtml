@model Progra_03.Models.Ruta

@{
    ViewBag.Title = "Crear ruta";
}

<div class="encabezado">
    <div class="container">
        <h1>Vuelos e itinerarios</h1>
        <p>Pantalla 18 · Administración de vuelos, frecuencias, rutas, aeropuertos, itinerarios y tramos.</p>
    </div>
</div>

<div class="container">
    @Html.Partial("_PestanasVuelos", "Rutas")

    <div class="row justify-content-center mt-3">
        <div class="col-lg-8">
            @Html.Partial("_Mensaje")

            @using (Html.BeginForm())
            {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="tarjeta">
                <h2>Crear ruta</h2>
                <div class="row g-3">
                @try
                {
                    <div class="col-md-6">
                        @Html.LabelFor(model => model.AeropuertoOrigenId, htmlAttributes: new { @class = "form-label" })
                        @Html.DropDownList("AeropuertoOrigenId", null, "Seleccione...", htmlAttributes: new { @class = "form-select" })
                        @Html.ValidationMessageFor(model => model.AeropuertoOrigenId, "Seleccione el aeropuerto de origen", new { @class = "text-info" })
                    </div>
                }
                catch (Exception ex)
                {
                    <div class="col-12 text-danger">Error en AeropuertoOrigenId: @ex.Message</div>
                }
                @try
                {
                    <div class="col-md-6">
                        @Html.LabelFor(model => model.AeropuertoDestinoId, htmlAttributes: new { @class = "form-label" })
                        @Html.DropDownList("AeropuertoDestinoId", null, "Seleccione...", htmlAttributes: new { @class = "form-select" })
                        @Html.ValidationMessageFor(model => model.AeropuertoDestinoId, "Seleccione el aeropuerto de destino", new { @class = "text-info" })
                    </div>
                }
                catch (Exception ex)
                {
                    <div class="col-12 text-danger">Error en AeropuertoDestinoId: @ex.Message</div>
                }
                @try
                {
                    <div class="col-md-6">
                        @Html.LabelFor(model => model.TarifaReferencial, htmlAttributes: new { @class = "form-label" })
                        @Html.EditorFor(model => model.TarifaReferencial, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.TarifaReferencial, "Ingrese una tarifa válida", new { @class = "text-info" })
                    </div>
                }
                catch (Exception ex)
                {
                    <div class="col-12 text-danger">Error en TarifaReferencial: @ex.Message</div>
                }
                @try
                {
                    <div class="col-md-6">
                        <div class="form-check mt-md-4">
                            @Html.CheckBoxFor(model => model.Activa, new { @class = "form-check-input" })
                            @Html.LabelFor(model => model.Activa, htmlAttributes: new { @class = "form-check-label" })
                        </div>
                    </div>
                }
                catch (Exception ex)
                {
                    <div class="col-12 text-danger">Error en Activa: @ex.Message</div>
                }
                </div>
                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-oro px-4">Guardar</button>
                    @Html.ActionLink("Volver a la lista", "Index", null, new { @class = "btn btn-outline-secondary" })
                </div>
            </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    @Html.Partial("_ScriptsValidacion")
}
