@model IEnumerable<Progra_03.Models.Ruta>

@{
    ViewBag.Title = "Inicio";
}

<div class="hero">
    <div class="container">
        <div class="row align-items-center g-4">
            <div class="col-lg-6">
                <div class="dorado fw-bold small mb-2">VUELOS PRIVADOS EN ECUADOR</div>
                <h1>Vuela exclusivo,<br />sin filas ni esperas</h1>
                <p class="text-white-50 mt-3">Elige tu asiento, paga en línea y haz tu check-in desde casa.</p>
            </div>
            <div class="col-lg-6">
                <div class="tarjeta text-dark">
                    <h2>Encuentra tu vuelo</h2>
                    @using (Html.BeginForm("Resultados", "Vuelos", FormMethod.Get, new { id = "formInicio" }))
                    {
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Origen</label>
                                @Html.DropDownList("origen", null, "Seleccione...", new { @class = "form-select", required = "required" })
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Destino</label>
                                @Html.DropDownList("destino", null, "Seleccione...", new { @class = "form-select", required = "required" })
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Fecha de salida</label>
                                <input type="date" id="fecha" name="fecha" class="form-control" min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Pasajeros</label>
                                @Html.DropDownList("pasajeros", null, new { @class = "form-select" })
                            </div>
                            <div class="col-12">
                                <div id="errorInicio" class="text-danger small d-none"></div>
                            </div>
                            <div class="col-md-6 d-grid">
                                <button type="submit" class="btn btn-oro py-2">Buscar vuelos</button>
                            </div>
                            <div class="col-md-6 d-grid">
                                <a class="btn btn-outline-secondary py-2" href="@Url.Action("Buscar", "Vuelos")">Ver calendario de vuelos</a>
                            </div>
                        </div>
                        <p class="small text-muted mt-3 mb-0">Horarios sujetos a la programación establecida y disponibilidad real.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container">
    <div class="tarjeta my-4 py-3">
        <div class="row text-center">
            <div class="col-6 col-md-3"><div class="fs-3 fw-bold dorado">7</div><div class="small text-muted">asientos por vuelo</div></div>
            <div class="col-6 col-md-3"><div class="fs-3 fw-bold dorado">3</div><div class="small text-muted">Embraer Phenom 300E</div></div>
            <div class="col-6 col-md-3"><div class="fs-3 fw-bold dorado">4</div><div class="small text-muted">destinos en Ecuador</div></div>
            <div class="col-6 col-md-3"><div class="fs-3 fw-bold dorado">@Progra_03.Models.Vuelo.HorasCheckIn h</div><div class="small text-muted">check-in en línea</div></div>
        </div>
    </div>

    <h4 class="fw-bold mb-3" style="color:#12233f">Nuestras rutas</h4>
    <div class="row g-3">
        @foreach (var ruta in Model)
        {
            <div class="col-md-4">
                <div class="tarjeta h-100">
                    <div class="dorado small fw-bold">DESDE USD @ruta.TarifaReferencial.ToString("N2")</div>
                    <h2 class="mt-1 mb-1">@ruta.DescripcionCompleta</h2>
                    <p class="small text-muted mb-2">
                        @string.Join(", ", ruta.Frecuencias.Where(f => f.Activa).Select(f => f.NombreDia).Distinct())
                    </p>
                    <a class="small dorado fw-bold text-decoration-none" href="@Url.Action("Buscar", "Vuelos", new { origen = ruta.AeropuertoOrigenId, destino = ruta.AeropuertoDestinoId })">Ver vuelos →</a>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    @Html.Partial("_FiltroDestinos", (List<Progra_03.Models.Ruta>)ViewBag.Rutas)
    <script>
        $("#formInicio").on("submit", function (evento) {
            var mensaje = "";
            var hoy = "@DateTime.Today.ToString("yyyy-MM-dd")";

            if (!$("#origen").val()) {
                mensaje = "Seleccione el origen.";
            } else if (!$("#destino").val()) {
                mensaje = "Seleccione el destino.";
            } else if ($("#origen").val() === $("#destino").val()) {
                mensaje = "El destino debe ser diferente del origen.";
            } else if (!$("#fecha").val()) {
                mensaje = "Indique la fecha de salida.";
            } else if ($("#fecha").val() < hoy) {
                mensaje = "La fecha de salida no puede ser anterior a hoy.";
            }

            if (mensaje !== "") {
                evento.preventDefault();
                $("#errorInicio").text(mensaje).removeClass("d-none");
            } else {
                $("#errorInicio").addClass("d-none");
            }
        });
    </script>
}
