@model Progra_03.Models.ModeloAeronave

@{
    ViewBag.Title = "Crear modelo de aeronave";
}

<div class="encabezado">
    <div class="container">
        <h1>Aeronaves</h1>
        <p>Pantalla 19 · Flota de aeronaves con capacidad máxima de 7 asientos.</p>
    </div>
</div>

<div class="container">
    @Html.Partial("_PestanasAeronaves", "Modelos")

    <div class="row justify-content-center mt-3">
        <div class="col-lg-8">
            @Html.Partial("_Mensaje")

            @using (Html.BeginForm())
            {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="tarjeta">
                <h2>Crear modelo de aeronave</h2>
                <div class="row g-3">
                @try
                {
                    <div class="col-md-6">
                        @Html.LabelFor(model => model.Fabricante, htmlAttributes: new { @class = "form-label" })
                        @Html.EditorFor(model => model.Fabricante, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.Fabricante, "Ingrese un fabricante válido", new { @class = "text-info" })
                    </div>
                }
                catch (Exception ex)
                {
                    <div class="col-12 text-danger">Error en Fabricante: @ex.Message</div>
                }
                @try
                {
                    <div class="col-md-6">
                        @Html.LabelFor(model => model.Nombre, htmlAttributes: new { @class = "form-label" })
                        @Html.EditorFor(model => model.Nombre, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.Nombre, "Ingrese un nombre válido", new { @class = "text-info" })
                    </div>
                }
                catch (Exception ex)
                {
                    <div class="col-12 text-danger">Error en Nombre: @ex.Message</div>
                }
                @try
                {
                    <div class="col-md-4">
                        @Html.LabelFor(model => model.CapacidadAsientos, htmlAttributes: new { @class = "form-label" })
                        @Html.EditorFor(model => model.CapacidadAsientos, new { htmlAttributes = new { @class = "form-control", type = "number", min = "1", max = "7" } })
                        @Html.ValidationMessageFor(model => model.CapacidadAsientos, "Ingrese una capacidad entre 1 y 7", new { @class = "text-info" })
                    </div>
                }
                catch (Exception ex)
                {
                    <div class="col-12 text-danger">Error en CapacidadAsientos: @ex.Message</div>
                }
                </div>
                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-oro px-4">Guardar</button>
                    @Html.ActionLink("Volver a la lista", "Index", null, new { @class = "btn btn-outline-secondary" })
                </div>
            </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    @Html.Partial("_ScriptsValidacion")
}
