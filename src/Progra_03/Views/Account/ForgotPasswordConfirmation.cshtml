@{
    ViewBag.Title = "Solicitud recibida";
}

<div class="encabezado">
    <div class="container">
        <h1>Solicitud recibida</h1>
        <p>Pantalla 4 · Recuperación de acceso.</p>
    </div>
</div>

<div class="container">
    <div class="row justify-content-center">
