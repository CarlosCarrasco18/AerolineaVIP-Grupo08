@model Progra_03.Models.Aeropuerto

@{
    ViewBag.Title = "Detalle de aeropuerto";
}

<div class="encabezado">
    <div class="container">
        <h1>Vuelos e itinerarios</h1>
        <p>Pantalla 18 · Administración de vuelos, frecuencias, rutas, aeropuertos, itinerarios y tramos.</p>
    </div>
</div>

<div class="container">
    @Html.Partial("_PestanasVuelos", "Aeropuertos")

    <div class="row justify-content-center mt-3">
        <div class="col-lg-8">
            <div class="tarjeta">
                <h2>Detalle de aeropuerto</h2>
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">Código IATA</dt>
                    <dd class="col-sm-8">@Model.CodigoIATA</dd>
                    <dt class="col-sm-4 text-muted">Nombre</dt>
                    <dd class="col-sm-8">@Model.Nombre</dd>
                    <dt class="col-sm-4 text-muted">Localidad</dt>
                    <dd class="col-sm-8">@Model.Localidad</dd>
                    <dt class="col-sm-4 text-muted">Activo</dt>
                    <dd class="col-sm-8">@(Model.Activo ? "Sí" : "No")</dd>
                </dl>
            </div>

            <div class="d-flex gap-2 mt-3">
                @if (User.IsInRole("edit"))
                {
                    @Html.ActionLink("Editar", "Edit", new { id = Model.AeropuertoId }, new { @class = "btn btn-oro" })
                }
                @Html.ActionLink("Volver a la lista", "Index", null, new { @class = "btn btn-outline-secondary" })
            </div>
        </div>
    </div>
</div>
