@model Progra_03.Models.PagoViewModel

@{
    ViewBag.Title = "Pago";
    var reserva = (Progra_03.Models.Reserva)ViewBag.Reserva;
    var marcas = (List<Progra_03.Models.MarcaTarjeta>)ViewBag.Marcas;
}

<div class="encabezado">
    <div class="container">
        <h1>Pago</h1>
        <p>Pantalla 11 · Complete los datos de la tarjeta y confirme el pago en la ventana de confirmación.</p>
        @Html.Partial("_Pasos", 5)
    </div>
</div>

<div class="container">
    @Html.Partial("_Mensaje")
    <div class="alert alert-warning small"><b>Simulación académica:</b> no se realizan cobros reales. Una tarjeta terminada en 0000 simula un pago rechazado.</div>

    <div class="row g-4">
        <div class="col-lg-7">
            @if (ViewBag.Message == null)
            {
                <div class="alert alert-success small">Reserva <b>@reserva.CodigoReserva</b> registrada. Complete el pago antes de las @(reserva.FechaExpiracion != null ? reserva.FechaExpiracion.Value.ToString("HH:mm") : "") para confirmarla.</div>

                using (Html.BeginForm("Pagar", "Compras", FormMethod.Post, new { id = "formPago", autocomplete = "off" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(model => model.ReservaId)

                    <div class="tarjeta">
                        <h2>Datos de la tarjeta</h2>
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                        <div class="row g-3">
                            @try
                            {
                                <div class="col-md-6">
                                    @Html.LabelFor(model => model.MetodoPagoCodigo, htmlAttributes: new { @class = "form-label" })
                                    @Html.DropDownList("MetodoPagoCodigo", null, "Seleccione...", new { @class = "form-select" })
                                    @Html.ValidationMessageFor(model => model.MetodoPagoCodigo, "Seleccione el método de pago", new { @class = "text-info" })
                                </div>
                            }
                            catch (Exception ex)
                            {
                                <div class="col-12 text-danger">Error en MetodoPagoCodigo: @ex.Message</div>
                            }
                            @try
                            {
                                <div class="col-md-6">
                                    @Html.LabelFor(model => model.MarcaTarjetaCodigo, htmlAttributes: new { @class = "form-label" })
                                    @Html.DropDownList("MarcaTarjetaCodigo", null, "Seleccione...", new { @class = "form-select" })
                                    @Html.ValidationMessageFor(model => model.MarcaTarjetaCodigo, "Seleccione la marca de la tarjeta", new { @class = "text-info" })
                                </div>
                            }
                            catch (Exception ex)
                            {
                                <div class="col-12 text-danger">Error en MarcaTarjetaCodigo: @ex.Message</div>
                            }
                            @try
                            {
                                <div class="col-12">
                                    @Html.LabelFor(model => model.NumeroTarjeta, htmlAttributes: new { @class = "form-label" })
                                    @Html.EditorFor(model => model.NumeroTarjeta, new { htmlAttributes = new { @class = "form-control", inputmode = "numeric", maxlength = "19", placeholder = "Solo números" } })
                                    @Html.ValidationMessageFor(model => model.NumeroTarjeta, "Ingrese un número de tarjeta válido", new { @class = "text-info" })
                                </div>
                            }
                            catch (Exception ex)
                            {
                                <div class="col-12 text-danger">Error en NumeroTarjeta: @ex.Message</div>
                            }
                            @try
                            {
                                <div class="col-12">
                                    @Html.LabelFor(model => model.NombreTitular, htmlAttributes: new { @class = "form-label" })
                                    @Html.EditorFor(model => model.NombreTitular, new { htmlAttributes = new { @class = "form-control", placeholder = "Como aparece en la tarjeta" } })
                                    @Html.ValidationMessageFor(model => model.NombreTitular, "Ingrese el nombre del titular (solo letras)", new { @class = "text-info" })
                                </div>
                            }
                            catch (Exception ex)
                            {
                                <div class="col-12 text-danger">Error en NombreTitular: @ex.Message</div>
                            }
                            @try
                            {
                                <div class="col-md-6">
                                    @Html.LabelFor(model => model.Vencimiento, htmlAttributes: new { @class = "form-label" })
                                    @Html.EditorFor(model => model.Vencimiento, new { htmlAttributes = new { @class = "form-control", inputmode = "numeric", maxlength = "5", placeholder = "MM/AA" } })
                                    @Html.ValidationMessageFor(model => model.Vencimiento, "Ingrese una fecha de vencimiento válida (MM/AA)", new { @class = "text-info" })
                                </div>
                            }
                            catch (Exception ex)
                            {
                                <div class="col-12 text-danger">Error en Vencimiento: @ex.Message</div>
                            }
                            @try
                            {
                                <div class="col-md-6">
                                    @Html.LabelFor(model => model.CodigoSeguridad, htmlAttributes: new { @class = "form-label" })
                                    @Html.EditorFor(model => model.CodigoSeguridad, new { htmlAttributes = new { @class = "form-control", inputmode = "numeric", maxlength = "4" } })
                                    @Html.ValidationMessageFor(model => model.CodigoSeguridad, "Ingrese un CVV válido", new { @class = "text-info" })
                                </div>
                            }
                            catch (Exception ex)
                            {
                                <div class="col-12 text-danger">Error en CodigoSeguridad: @ex.Message</div>
                            }
                            <div class="col-12 d-grid">
                                <button type="button" id="btnPagar" class="btn btn-oro py-2">Pagar USD @reserva.CalcularTotal().ToString("N2")</button>
                            </div>
                        </div>
                    </div>
                }

                <div class="modal fade" id="modalConfirmarPago" tabindex="-1" aria-labelledby="tituloModalPago" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="tituloModalPago">¿Está seguro de que desea realizar este pago?</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                            </div>
                            <div class="modal-body small">
                                <div class="d-flex justify-content-between"><span>Reserva</span><b>@reserva.CodigoReserva</b></div>
                                <div class="d-flex justify-content-between"><span>Vuelos</span><b class="text-end">@reserva.DescripcionVuelos()</b></div>
                                <div class="d-flex justify-content-between"><span>Pasajeros</span><b>@reserva.CalcularPasajeros()</b></div>
                                <div class="d-flex justify-content-between"><span>Método</span><b id="modalMetodo"></b></div>
                                <div class="d-flex justify-content-between"><span>Tarjeta</span><b id="modalTarjeta"></b></div>
                                <hr />
                                <div class="d-flex justify-content-between"><span>Monto total</span><b class="fs-5">USD @reserva.CalcularTotal().ToString("N2")</b></div>
                                <div class="text-muted mt-2">Estado: pago simulado sin procesar. Si cancela, no se registra ningún pago.</div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                                <button type="button" id="btnConfirmarPago" class="btn btn-oro">Pagar</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <a class="btn btn-outline-secondary" href="@Url.Action(User.IsInRole("Counter") ? "Atencion" : "MisReservas", "Reservas")">Volver</a>
            }
        </div>
        <div class="col-lg-5">
            <div class="resumen">
                <div class="dorado">RESUMEN DE COMPRA</div>
                <div class="small mt-2">Reserva <b>@reserva.CodigoReserva</b></div>
                <div class="small">@reserva.DescripcionVuelos()</div>
                <div class="small">@reserva.CalcularPasajeros() pasajero(s)</div>
                <hr />
                <div class="d-flex justify-content-between"><span>Total</span><b class="fs-4">USD @reserva.CalcularTotal().ToString("N2")</b></div>
            </div>
            <a class="btn btn-outline-secondary w-100 mt-3" href="@Url.Action(User.IsInRole("Counter") ? "Atencion" : "MisReservas", "Reservas")">Pagar después</a>
        </div>
    </div>
</div>

@section Scripts {
    @Html.Partial("_ScriptsValidacion")
    <script>
        var longitudes = {};
        @foreach (var marca in marcas)
        {
            @:longitudes["@marca.Codigo"] = { numero: @marca.LongitudNumero, cvv: @marca.LongitudCodigoSeguridad };
        }

        $("#NumeroTarjeta, #CodigoSeguridad").on("input", function () {
            this.value = this.value.replace(/\D/g, "");
        });

        $("#Vencimiento").on("input", function () {
            var valor = this.value.replace(/\D/g, "").slice(0, 4);
            if (valor.length > 2) {
                valor = valor.slice(0, 2) + "/" + valor.slice(2);
            }
            this.value = valor;
        });

        $("#MarcaTarjetaCodigo").on("change", function () {
            var marca = longitudes[$(this).val()];
            if (marca) {
                $("#NumeroTarjeta").attr("maxlength", marca.numero);
                $("#CodigoSeguridad").attr("maxlength", marca.cvv);
            }
        });

        $("#btnPagar").on("click", function () {
            if (!$("#formPago").valid()) {
                return;
            }

            var marca = longitudes[$("#MarcaTarjetaCodigo").val()];
            var numero = $("#NumeroTarjeta").val();
            if (marca && numero.length !== marca.numero) {
                alert("La tarjeta " + $("#MarcaTarjetaCodigo option:selected").text() + " debe tener " + marca.numero + " dígitos.");
                return;
            }

            if (marca && $("#CodigoSeguridad").val().length !== marca.cvv) {
                alert("El CVV de " + $("#MarcaTarjetaCodigo option:selected").text() + " tiene " + marca.cvv + " dígitos.");
                return;
            }

            $("#modalMetodo").text($("#MetodoPagoCodigo option:selected").text());
            $("#modalTarjeta").text($("#MarcaTarjetaCodigo option:selected").text() + " **** " + numero.slice(-4));
            var modal = new bootstrap.Modal(document.getElementById("modalConfirmarPago"));
            modal.show();
        });

        $("#btnConfirmarPago").on("click", function () {
            $(this).prop("disabled", true).text("Procesando...");
            $("#formPago").submit();
        });
    </script>
}
