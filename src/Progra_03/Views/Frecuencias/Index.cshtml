@model IEnumerable<Progra_03.Models.Frecuencia>

@{
    ViewBag.Title = "Vuelos e itinerarios";
}

<div class="encabezado">
    <div class="container">
        <h1>Vuelos e itinerarios</h1>
        <p>Pantalla 18 · Administración de vuelos, frecuencias, rutas, aeropuertos, itinerarios y tramos.</p>
    </div>
</div>

<div class="container">
    @Html.Partial("_PestanasVuelos", "Frecuencias")

    <div class="d-flex justify-content-between align-items-center my-3">
        <span class="text-muted small">@Html.ActionLink("← Administración", "Index", "Admin") · @Model.Count() registro(s)</span>
        @if (User.IsInRole("create"))
        {
            @Html.ActionLink("+ Crear nuevo", "Create", null, new { @class = "btn btn-oro btn-sm" })
        }
    </div>

    @using (Html.BeginForm("Index", null, FormMethod.Get, new { @class = "tarjeta mb-3 py-3" }))
    {
        <div class="row g-2 align-items-end">
            <div class="col-md-9">
                <label class="form-label">Ruta</label>
                @Html.DropDownList("rutaId", null, "Todas", new { @class = "form-select" })
            </div>
            <div class="col">
                <button type="submit" class="btn btn-azul w-100">Filtrar</button>
            </div>
        </div>
    }

    <div class="tabla">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Ruta</th>
                    <th>Día</th>
                    <th>Salida</th>
                    <th>Llegada</th>
                    <th>Activa</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><b>@item.Ruta.Descripcion</b></td>
                        <td>@item.NombreDia</td>
                        <td>@item.HoraSalida.ToString(@"hh\:mm")</td>
                        <td>@item.HoraLlegada.ToString(@"hh\:mm")</td>
                        <td>@(item.Activa ? "Sí" : "No")</td>
                        <td class="text-end">
                            <span class="acc">
                                @Html.ActionLink("Detalles", "Details", new { id = item.FrecuenciaId })
                                @if (User.IsInRole("edit"))
                                {
                                    @Html.ActionLink("Editar", "Edit", new { id = item.FrecuenciaId })
                                }
                                @if (User.IsInRole("delete"))
                                {
                                    @Html.ActionLink("Eliminar", "Delete", new { id = item.FrecuenciaId }, new { @class = "borrar" })
                                }
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
