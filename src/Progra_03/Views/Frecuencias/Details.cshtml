@model Progra_03.Models.Frecuencia

@{
    ViewBag.Title = "Detalle de frecuencia";
}

<div class="encabezado">
    <div class="container">
        <h1>Vuelos e itinerarios</h1>
        <p>Pantalla 18 · Administración de vuelos, frecuencias, rutas, aeropuertos, itinerarios y tramos.</p>
    </div>
</div>

<div class="container">
    @Html.Partial("_PestanasVuelos", "Frecuencias")

    <div class="row justify-content-center mt-3">
        <div class="col-lg-8">
            <div class="tarjeta">
                <h2>Detalle de frecuencia</h2>
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">Ruta</dt>
                    <dd class="col-sm-8">@Model.Ruta.DescripcionCompleta</dd>
                    <dt class="col-sm-4 text-muted">Día</dt>
                    <dd class="col-sm-8">@Model.NombreDia</dd>
                    <dt class="col-sm-4 text-muted">Horario</dt>
                    <dd class="col-sm-8">@Model.Horario</dd>
                    <dt class="col-sm-4 text-muted">Activa</dt>
                    <dd class="col-sm-8">@(Model.Activa ? "Sí" : "No")</dd>
                    <dt class="col-sm-4 text-muted">Vuelos programados</dt>
                    <dd class="col-sm-8">@Model.Vueloes.Count</dd>
                </dl>
            </div>

            <div class="d-flex gap-2 mt-3">
                @if (User.IsInRole("edit"))
                {
                    @Html.ActionLink("Editar", "Edit", new { id = Model.FrecuenciaId }, new { @class = "btn btn-oro" })
                }
                @Html.ActionLink("Volver a la lista", "Index", null, new { @class = "btn btn-outline-secondary" })
            </div>
        </div>
    </div>
</div>
