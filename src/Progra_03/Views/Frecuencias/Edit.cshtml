@model Progra_03.Models.Frecuencia

@{
    ViewBag.Title = "Editar frecuencia";
}

<div class="encabezado">
    <div class="container">
        <h1>Vuelos e itinerarios</h1>
        <p>Pantalla 18 · Administración de vuelos, frecuencias, rutas, aeropuertos, itinerarios y tramos.</p>
    </div>
</div>

<div class="container">
    @Html.Partial("_PestanasVuelos", "Frecuencias")

    <div class="row justify-content-center mt-3">
        <div class="col-lg-8">
            @Html.Partial("_Mensaje")

            @using (Html.BeginForm())
            {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            @Html.HiddenFor(model => model.FrecuenciaId)

            <div class="tarjeta">
                <h2>Editar frecuencia</h2>
                <div class="row g-3">
                @try
                {
                    <div class="col-md-6">
                        @Html.LabelFor(model => model.RutaId, htmlAttributes: new { @class = "form-label" })
                        @Html.DropDownList("RutaId", null, "Seleccione...", htmlAttributes: new { @class = "form-select" })
                        @Html.ValidationMessageFor(model => model.RutaId, "Seleccione la ruta", new { @class = "text-info" })
                    </div>
                }
                catch (Exception ex)
                {
                    <div class="col-12 text-danger">Error en RutaId: @ex.Message</div>
                }
                @try
                {
                    <div class="col-md-6">
                        @Html.LabelFor(model => model.DiaSemana, htmlAttributes: new { @class = "form-label" })
                        @Html.DropDownList("DiaSemana", null, "Seleccione...", htmlAttributes: new { @class = "form-select" })
                        @Html.ValidationMessageFor(model => model.DiaSemana, "Seleccione el día de operación", new { @class = "text-info" })
                    </div>
                }
                catch (Exception ex)
                {
                    <div class="col-12 text-danger">Error en DiaSemana: @ex.Message</div>
                }
                @try
                {
                    <div class="col-md-6">
                        @Html.LabelFor(model => model.HoraSalida, htmlAttributes: new { @class = "form-label" })
                        @Html.EditorFor(model => model.HoraSalida, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.HoraSalida, "Ingrese una hora de salida válida", new { @class = "text-info" })
                    </div>
                }
                catch (Exception ex)
                {
                    <div class="col-12 text-danger">Error en HoraSalida: @ex.Message</div>
                }
                @try
                {
                    <div class="col-md-6">
                        @Html.LabelFor(model => model.HoraLlegada, htmlAttributes: new { @class = "form-label" })
                        @Html.EditorFor(model => model.HoraLlegada, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.HoraLlegada, "Ingrese una hora de llegada válida", new { @class = "text-info" })
                    </div>
                }
                catch (Exception ex)
                {
                    <div class="col-12 text-danger">Error en HoraLlegada: @ex.Message</div>
                }
                @try
                {
                    <div class="col-md-6">
                        <div class="form-check mt-md-4">
                            @Html.CheckBoxFor(model => model.Activa, new { @class = "form-check-input" })
                            @Html.LabelFor(model => model.Activa, htmlAttributes: new { @class = "form-check-label" })
                        </div>
                    </div>
                }
                catch (Exception ex)
                {
                    <div class="col-12 text-danger">Error en Activa: @ex.Message</div>
                }
                </div>
                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-oro px-4">Guardar</button>
                    @Html.ActionLink("Volver a la lista", "Index", null, new { @class = "btn btn-outline-secondary" })
                </div>
            </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    @Html.Partial("_ScriptsValidacion")
}
