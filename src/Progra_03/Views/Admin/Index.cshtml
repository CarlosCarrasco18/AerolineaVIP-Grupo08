@{
    ViewBag.Title = "Administración";
}

<div class="encabezado">
    <div class="container">
        <h1>Administración</h1>
        <p>Accesos a los módulos según sus permisos.</p>
    </div>
</div>

<div class="container">
    <div class="mb-3 small">@Html.ActionLink("← Volver al inicio", "Index", "Home")</div>
    <div class="row g-3">
        <div class="col-md-6 col-lg-3">
            <a class="tarjeta modulo" href="@Url.Action("Vuelos", "Admin")">
                <div class="ico">V</div>
                <h2 class="mb-1">Vuelos e itinerarios</h2>
                <p class="small text-muted mb-2">Generar vuelos, conflictos, vuelos, frecuencias, rutas, aeropuertos, itinerarios y tramos.</p>
                <span class="small dorado fw-bold">Entrar →</span>
            </a>
        </div>
        <div class="col-md-6 col-lg-3">
            <a class="tarjeta modulo" href="@Url.Action("Aeronaves", "Admin")">
                <div class="ico">A</div>
                <h2 class="mb-1">Aeronaves</h2>
                <p class="small text-muted mb-2">Flota, modelos y estado operativo.</p>
                <span class="small dorado fw-bold">Entrar →</span>
            </a>
        </div>
        <div class="col-md-6 col-lg-3">
            <a class="tarjeta modulo" href="@Url.Action("Gestion", "Admin")">
                <div class="ico">U</div>
                <h2 class="mb-1">Usuarios, pasajeros y reservas</h2>
                <p class="small text-muted mb-2">Búsqueda general, usuarios y roles, pasajeros y reservas.</p>
                <span class="small dorado fw-bold">Entrar →</span>
            </a>
        </div>
        <div class="col-md-6 col-lg-3">
            <a class="tarjeta modulo" href="@Url.Action("Reportes", "Admin")">
                <div class="ico">R</div>
                <h2 class="mb-1">Reportes</h2>
                <p class="small text-muted mb-2">Ocupación, reservas por estado y compras con sus pagos.</p>
                <span class="small dorado fw-bold">Entrar →</span>
            </a>
        </div>
    </div>
</div>
