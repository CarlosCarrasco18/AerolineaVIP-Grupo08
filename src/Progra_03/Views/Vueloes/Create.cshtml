@model Progra_03.Models.Vuelo

@{
    ViewBag.Title = "Crear vuelo";
}

<div class="encabezado">
    <div class="container">
        <h1>Vuelos e itinerarios</h1>
        <p>Pantalla 18 · Administración de vuelos, frecuencias, rutas, aeropuertos, itinerarios y tramos.</p>
    </div>
</div>

<div class="container">
    @Html.Partial("_PestanasVuelos", "Vuelos")

    <div class="row justify-content-center mt-3">
        <div class="col-lg-8">
            @Html.Partial("_Mensaje")

            @using (Html.BeginForm())
            {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="tarjeta">
                <h2>Crear vuelo</h2>
                <div class="row g-3">
                @try
                {
                    <div class="col-12">
                        @Html.LabelFor(model => model.FrecuenciaId, htmlAttributes: new { @class = "form-label" })
                        @Html.DropDownList("FrecuenciaId", null, "Seleccione...", htmlAttributes: new { @class = "form-select" })
                        @Html.ValidationMessageFor(model => model.FrecuenciaId, "Seleccione la frecuencia", new { @class = "text-info" })
                    </div>
                }
                catch (Exception ex)
                {
                    <div class="col-12 text-danger">Error en FrecuenciaId: @ex.Message</div>
                }
                @try
                {
                    <div class="col-md-6">
                        @Html.LabelFor(model => model.FechaOperacion, htmlAttributes: new { @class = "form-label" })
                        @Html.EditorFor(model => model.FechaOperacion, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.FechaOperacion, "Ingrese una fecha de operación válida", new { @class = "text-info" })
                    </div>
                }
                catch (Exception ex)
                {
                    <div class="col-12 text-danger">Error en FechaOperacion: @ex.Message</div>
                }
                @try
                {
                    <div class="col-md-6">
                        @Html.LabelFor(model => model.AeronaveId, htmlAttributes: new { @class = "form-label" })
                        @Html.DropDownList("AeronaveId", null, "(sin asignar)", htmlAttributes: new { @class = "form-select" })
                        @Html.ValidationMessageFor(model => model.AeronaveId, "Seleccione una aeronave válida", new { @class = "text-info" })
                    </div>
                }
                catch (Exception ex)
                {
                    <div class="col-12 text-danger">Error en AeronaveId: @ex.Message</div>
                }
                @try
                {
                    <div class="col-md-6">
                        @Html.LabelFor(model => model.EstadoVueloCodigo, htmlAttributes: new { @class = "form-label" })
                        @Html.DropDownList("EstadoVueloCodigo", null, "Seleccione...", htmlAttributes: new { @class = "form-select" })
                        @Html.ValidationMessageFor(model => model.EstadoVueloCodigo, "Seleccione el estado del vuelo", new { @class = "text-info" })
                    </div>
                }
                catch (Exception ex)
                {
                    <div class="col-12 text-danger">Error en EstadoVueloCodigo: @ex.Message</div>
                }
                </div>
                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-oro px-4">Guardar</button>
                    @Html.ActionLink("Volver a la lista", "Index", null, new { @class = "btn btn-outline-secondary" })
                </div>
            </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    @Html.Partial("_ScriptsValidacion")
}
