@model IEnumerable<Progra_03.Models.Vuelo>

@{
    ViewBag.Title = "Vuelos e itinerarios";
}

<div class="encabezado">
    <div class="container">
        <h1>Vuelos e itinerarios</h1>
        <p>Pantalla 18 · Administración de vuelos, frecuencias, rutas, aeropuertos, itinerarios y tramos.</p>
    </div>
</div>

<div class="container">
    @Html.Partial("_PestanasVuelos", "Vuelos")

    <div class="d-flex justify-content-between align-items-center my-3">
        <span class="text-muted small">@Html.ActionLink("← Administración", "Index", "Admin") · @Model.Count() registro(s)</span>
        @if (User.IsInRole("create"))
        {
            @Html.ActionLink("+ Crear nuevo", "Create", null, new { @class = "btn btn-oro btn-sm" })
        }
    </div>

    @using (Html.BeginForm("Index", null, FormMethod.Get, new { @class = "tarjeta mb-3 py-3" }))
    {
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Fecha</label>
                <input type="date" name="fecha" value="@(ViewBag.Fecha != null ? ((DateTime)ViewBag.Fecha).ToString("yyyy-MM-dd") : "")" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Ruta</label>
                @Html.DropDownList("rutaId", null, "Todas", new { @class = "form-select" })
            </div>
            <div class="col-md-3">
                <label class="form-label">Estado</label>
                @Html.DropDownList("estado", null, "Todos", new { @class = "form-select" })
            </div>
            <div class="col">
                <button type="submit" class="btn btn-azul w-100">Filtrar</button>
            </div>
        </div>
    }

    <div class="tabla">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Vuelo</th>
                    <th>Fecha</th>
                    <th>Ruta</th>
                    <th>Horario</th>
                    <th>Aeronave</th>
                    <th>Ocupación</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><b>@item.CodigoVuelo</b></td>
                        <td>@item.FechaOperacion.ToString("dd/MM/yyyy")</td>
                        <td>@item.Frecuencia.Ruta.Descripcion</td>
                        <td>@item.Frecuencia.Horario</td>
                        <td>@(item.Aeronave != null ? item.Aeronave.Matricula : "Sin asignar")</td>
                        <td>@item.CalcularAsientosOcupados() / @item.CalcularCapacidad()</td>
                        <td><span class="estado e-@(item.EstadoVueloCodigo)">@item.EstadoVueloCodigo</span></td>
                        <td class="text-end">
                            <span class="acc">
                                @Html.ActionLink("Detalles", "Details", new { id = item.VueloId })
                                @if (User.IsInRole("edit"))
                                {
                                    @Html.ActionLink("Editar", "Edit", new { id = item.VueloId })
                                }
                                @if (User.IsInRole("delete"))
                                {
                                    @Html.ActionLink("Eliminar", "Delete", new { id = item.VueloId }, new { @class = "borrar" })
                                }
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
