@model Progra_03.Models.Reserva

@{
    ViewBag.Title = "Editar reserva";
}

<div class="encabezado">
    <div class="container">
        <h1>Usuarios, pasajeros y reservas</h1>
        <p>Pantalla 20 · Ampliar el plazo de pago de una reserva pendiente.</p>
    </div>
</div>

<div class="container">
    @Html.Partial("_PestanasUsuarios", "Reservas")

    <div class="row justify-content-center mt-3">
        <div class="col-lg-8">
            @Html.Partial("_Mensaje")

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(model => model.ReservaId)

                <div class="tarjeta">
                    <h2>Editar reserva @Model.CodigoReserva</h2>
                    <dl class="row">
                        <dt class="col-sm-4 text-muted">Estado</dt>
                        <dd class="col-sm-8"><span class="estado e-@Model.EstadoReservaCodigo">@Model.EstadoReservaCodigo</span></dd>
                        <dt class="col-sm-4 text-muted">Creada</dt>
                        <dd class="col-sm-8">@Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</dd>
                    </dl>
                    <div class="row g-3">
                        @try
                        {
                            <div class="col-md-6">
                                @Html.LabelFor(model => model.FechaExpiracion, htmlAttributes: new { @class = "form-label" })
                                <input type="datetime-local" name="FechaExpiracion" class="form-control" value="@(Model.FechaExpiracion != null ? Model.FechaExpiracion.Value.ToString("yyyy-MM-ddTHH:mm") : "")" />
                                @Html.ValidationMessageFor(model => model.FechaExpiracion, "Ingrese una fecha de expiración válida", new { @class = "text-info" })
                            </div>
                        }
                        catch (Exception ex)
                        {
                            <div class="col-12 text-danger">Error en FechaExpiracion: @ex.Message</div>
                        }
                    </div>
                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-oro px-4">Guardar</button>
                        @Html.ActionLink("Volver a la lista", "Index", null, new { @class = "btn btn-outline-secondary" })
                    </div>
                </div>
            }
        </div>
    </div>
</div>
