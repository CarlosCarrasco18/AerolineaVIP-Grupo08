@model Progra_03.Models.TramoItinerario

@{
    ViewBag.Title = "Eliminar tramo";
}

<div class="encabezado">
    <div class="container">
        <h1>Vuelos e itinerarios</h1>
        <p>Pantalla 18 · Administración de vuelos, frecuencias, rutas, aeropuertos, itinerarios y tramos.</p>
    </div>
</div>

<div class="container">
    @Html.Partial("_PestanasVuelos", "Tramos")

    <div class="row justify-content-center mt-3">
        <div class="col-lg-8">
            @Html.Partial("_Mensaje")

            <div class="tarjeta">
                <h2>¿Desea eliminar este registro?</h2>
                <dl class="row mb-3">
                    <dt class="col-sm-4 text-muted">Itinerario</dt>
                    <dd class="col-sm-8">@Model.Itinerario.Referencia · @Model.Itinerario.Nombre</dd>
                    <dt class="col-sm-4 text-muted">Orden</dt>
                    <dd class="col-sm-8">@Model.Orden</dd>
                    <dt class="col-sm-4 text-muted">Vuelo</dt>
                    <dd class="col-sm-8">@Model.Vuelo.Descripcion</dd>
                </dl>

                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    <div class="d-flex gap-2">
                        @if (ViewBag.Message == null)
                        {
                            <button type="submit" class="btn btn-danger px-4">Eliminar</button>
                        }
                        @Html.ActionLink("Volver a la lista", "Index", new { itinerarioId = Model.ItinerarioId }, new { @class = "btn btn-outline-secondary" })
                    </div>
                }
            </div>
        </div>
    </div>
</div>
