@model Progra_03.Models.TramoItinerario

@{
    ViewBag.Title = "Crear tramo";
}

<div class="encabezado">
    <div class="container">
        <h1>Vuelos e itinerarios</h1>
        <p>Pantalla 18 · Administración de vuelos, frecuencias, rutas, aeropuertos, itinerarios y tramos.</p>
    </div>
</div>

<div class="container">
    @Html.Partial("_PestanasVuelos", "Tramos")

    <div class="row justify-content-center mt-3">
        <div class="col-lg-8">
            @Html.Partial("_Mensaje")

            @using (Html.BeginForm())
            {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="tarjeta">
                <h2>Crear tramo</h2>
                <div class="row g-3">
                @try
                {
                    <div class="col-md-6">
                        @Html.LabelFor(model => model.ItinerarioId, htmlAttributes: new { @class = "form-label" })
                        @Html.DropDownList("ItinerarioId", null, "Seleccione...", htmlAttributes: new { @class = "form-select" })
                        @Html.ValidationMessageFor(model => model.ItinerarioId, "Seleccione el itinerario", new { @class = "text-info" })
                    </div>
                }
                catch (Exception ex)
                {
                    <div class="col-12 text-danger">Error en ItinerarioId: @ex.Message</div>
                }
                @try
                {
                    <div class="col-md-6">
                        @Html.LabelFor(model => model.Orden, htmlAttributes: new { @class = "form-label" })
                        @Html.EditorFor(model => model.Orden, new { htmlAttributes = new { @class = "form-control" } })
                        @Html.ValidationMessageFor(model => model.Orden, "Ingrese un orden válido (1 a 10)", new { @class = "text-info" })
                    </div>
                }
                catch (Exception ex)
                {
                    <div class="col-12 text-danger">Error en Orden: @ex.Message</div>
                }
                @try
                {
                    <div class="col-12">
                        @Html.LabelFor(model => model.VueloId, htmlAttributes: new { @class = "form-label" })
                        @Html.DropDownList("VueloId", null, "Seleccione...", htmlAttributes: new { @class = "form-select" })
                        @Html.ValidationMessageFor(model => model.VueloId, "Seleccione el vuelo", new { @class = "text-info" })
                    </div>
                }
                catch (Exception ex)
                {
                    <div class="col-12 text-danger">Error en VueloId: @ex.Message</div>
                }
                </div>
                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-oro px-4">Guardar</button>
                    @Html.ActionLink("Volver a la lista", "Index", new { itinerarioId = Model.ItinerarioId }, new { @class = "btn btn-outline-secondary" })
                </div>
            </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    @Html.Partial("_ScriptsValidacion")
}
