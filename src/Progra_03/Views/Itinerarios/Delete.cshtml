@model Progra_03.Models.Itinerario

@{
    ViewBag.Title = "Eliminar itinerario";
}

<div class="encabezado">
    <div class="container">
        <h1>Vuelos e itinerarios</h1>
        <p>Pantalla 18 · Administración de vuelos, frecuencias, rutas, aeropuertos, itinerarios y tramos.</p>
    </div>
</div>

<div class="container">
    @Html.Partial("_PestanasVuelos", "Itinerarios")

    <div class="row justify-content-center mt-3">
        <div class="col-lg-8">
            @Html.Partial("_Mensaje")

            <div class="tarjeta">
                <h2>¿Desea eliminar este registro?</h2>
                <dl class="row mb-3">
                    <dt class="col-sm-4 text-muted">Referencia</dt>
                    <dd class="col-sm-8">@Model.Referencia</dd>
                    <dt class="col-sm-4 text-muted">Nombre</dt>
                    <dd class="col-sm-8">@Model.Nombre</dd>
                    <dt class="col-sm-4 text-muted">Estado</dt>
                    <dd class="col-sm-8"><span class="estado e-@(Model.EstadoItinerarioCodigo)">@Model.EstadoItinerarioCodigo</span></dd>
                    <dt class="col-sm-4 text-muted">Tramos</dt>
                    <dd class="col-sm-8">@Model.TramoItinerarios.Count</dd>
                </dl>

                @using (Html.BeginForm())
                {
                    @Html.AntiForgeryToken()
                    <div class="d-flex gap-2">
                        @if (ViewBag.Message == null)
                        {
                            <button type="submit" class="btn btn-danger px-4">Eliminar</button>
                        }
                        @Html.ActionLink("Volver a la lista", "Index", null, new { @class = "btn btn-outline-secondary" })
                    </div>
                }
            </div>
        </div>
    </div>
</div>
